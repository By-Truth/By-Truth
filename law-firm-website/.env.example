# Copy to .env.local and fill in. Never commit real secrets.
# None of these are exposed to the browser except NEXT_PUBLIC_SITE_URL.

# Public URL of the site (used for canonical URLs, Open Graph and the sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com.ng

# Secret used to sign form tokens (CSRF / bot protection). 32+ random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_TOKEN_SECRET=

# --- Form delivery: configure ONE option ---------------------------------

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
FORM_RECIPIENT_EMAIL=
FORM_SENDER_EMAIL=

# Option B: webhook (Zapier, Make, a CRM or your own endpoint)
FORM_WEBHOOK_URL=
# Optional: signs the JSON body with HMAC-SHA256 in the X-Signature header
FORM_WEBHOOK_SECRET=
